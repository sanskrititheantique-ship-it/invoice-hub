# Copy to .env.local for local development. On Vercel these live in Project Settings > Environment Variables.

# Added automatically when you connect a Neon database to the Vercel project.
DATABASE_URL=postgresql://user:password@ep-example-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Optional: Neon's direct (unpooled) URL, used by the migration script if present.
DATABASE_URL_UNPOOLED=

# Sign-in cookie key. At least 32 random characters. Generate one with:  openssl rand -base64 48
AUTH_SECRET=

# Your public address, used in share links (e.g. https://invoices.deepanshutyagi.live). Optional.
APP_URL=
